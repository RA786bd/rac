# Public site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.coolbond.com.bd

# Optional: where contact / service-request form submissions are forwarded.
# Leave empty to only log submissions on the server.
# Works with any JSON webhook (Zapier, Make, Formspree, Slack webhook, your CRM...)
CONTACT_WEBHOOK_URL=
